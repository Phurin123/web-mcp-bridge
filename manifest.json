{
  "manifest_version": 3,
  "name": "Web MCP Bridge",
  "version": "1.7.0",
  "description": "Connect ChatGPT, Gemini, Claude, DeepSeek, Qwen, and more web LLMs to local MCP servers via WebSocket.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Web MCP Bridge",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage", "alarms", "notifications", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://*.kimi.com/*",
    "https://*.kimi.ai/*",
    "https://kimi.moonshot.cn/*",
    "https://chat.z.ai/*",
    "https://chat.qwen.ai/*",
    "https://copilot.microsoft.com/*",
    "https://github.com/copilot*",
    "https://*.meta.ai/*",
    "https://grok.com/*",
    "https://*.perplexity.ai/*",
    "https://chat.mistral.ai/*",
    "https://aistudio.google.com/*",
    "https://openrouter.ai/*",
    "https://poe.com/*",
    "https://huggingface.co/chat*",
    "https://t3.chat/*",
    "https://notebooklm.google.com/*",
    "ws://localhost/*",
    "ws://127.0.0.1/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://raw.githubusercontent.com/AstraxOf/web-mcp-bridge/*"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": [
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/ui_widget.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/chatgpt.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": [
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/ui_widget.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/gemini.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/ui_widget.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/claude.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": [
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/ui_widget.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/deepseek.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.kimi.com/*",
        "https://*.kimi.ai/*",
        "https://kimi.moonshot.cn/*",
        "https://chat.z.ai/*",
        "https://chat.qwen.ai/*",
        "https://copilot.microsoft.com/*",
        "https://github.com/copilot*",
        "https://*.meta.ai/*",
        "https://grok.com/*",
        "https://*.perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://aistudio.google.com/*",
        "https://openrouter.ai/*",
        "https://poe.com/*",
        "https://huggingface.co/chat*",
        "https://t3.chat/*",
        "https://notebooklm.google.com/*"
      ],
      "js": [
        "content_scripts/utils.js",
        "content_scripts/mcp_parser.js",
        "content_scripts/prompt_builder.js",
        "content_scripts/ui_widget.js",
        "content_scripts/adapters/base_adapter.js",
        "content_scripts/adapters/extra_chats.js",
        "content_scripts/core_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}